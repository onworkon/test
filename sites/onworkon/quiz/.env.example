# Add these to the project's .env.local (local) / Vercel Environment Variables.
# Use a NEW, dedicated Redis database. Never reuse the existing site's database.
QUIZ_EVENT_ID=student-event-2026
QUIZ_ORIGIN=http://localhost:3000
QUIZ_REDIS_REST_URL=https://your-quiz-only-database.upstash.io
QUIZ_REDIS_REST_TOKEN=replace-with-dedicated-database-token
# Generate both with: node quiz/scripts/admin-secret.js
QUIZ_ADMIN_PASSWORD_HASH=scrypt$replace-salt$replace-hash
QUIZ_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
